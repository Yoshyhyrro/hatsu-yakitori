-- CayleyDicksonQuiver.AbelianCurse.KoszulToy
--
-- One coordinate of the two-operator ("Koszul") toy from the AC8 part
-- of `note/AbelianCurseHypotheses.lagda.md`. With two commuting
-- operators on diagonal data, `Ext^i` splits by coordinate, and each
-- coordinate carries a pair `(d1, d2)` of eigenvalue differences
-- (`b_j - a_i` for each operator). The complex of one coordinate is
--
--   K0 = Z  --d0-->  K1 = Z^2  --d1-->  K2 = Z,
--   d0 x = (d1 x, d2 x),    d1 (a, b) = d2 a - d1 b,
--
-- with `H^0 = ker d0`, `H^1 = ker d1 / im d0`, `H^2 = coker d1`.
-- (The names `d0`, `d1` below take the pair `(delta1, delta2)` as
-- explicit arguments; the pair is written `δ1 δ2`.)
--
-- Checked below, for three explicit pairs only (no general statement
-- about `gcd`: that would need Bezout over `ℤ`):
--   * `(2, 4)`, gcd 2: `H^2 = Z/2` generated by the class of 1, and
--     `H^1 = Z/2` generated by the class of `(1, 2)`. The torsion of
--     `H^1` and `H^2` is the same group `Z/2`: no independent torsion
--     invariant in degree 2.
--   * `(3, 5)`, coprime: `H^2 = 0` and `H^1 = 0`.
--   * `(0, 0)`: both differentials vanish, so the ranks are
--     `(1, 2, 1)`; this is the only way `H^1` and `H^2` differ in the
--     diagonal toy (free rank 2 versus 1).
--
-- For one operator the corresponding statement is that `Ext^2` is
-- identically zero for `ℤ`-free modules; that is standard homological
-- algebra and is not formalized here.
--
-- Not imported by `Everything`; may contain holes.
module CayleyDicksonQuiver.AbelianCurse.KoszulToy where

open import CayleyDicksonQuiver.AbelianCurse.Ext1Torsion using (2x≢1)
open import Data.Integer using (ℤ; _+_; _*_; -_) renaming (+_ to pos; -[1+_] to neg[1+_])
open import Data.Integer.Properties using (+-identityʳ)
open import Data.Integer.Solver using (module +-*-Solver)
open import Data.Nat using (zero; suc)
open import Data.Product using (Σ; _×_; _,_; proj₁)
open import Relation.Binary.PropositionalEquality using (_≡_; refl; cong; trans; sym)
open import Relation.Nullary using (¬_)
open +-*-Solver

------------------------------------------------------------------------
-- The complex
------------------------------------------------------------------------

d0 : ℤ → ℤ → ℤ → ℤ × ℤ
d0 δ1 δ2 x = δ1 * x , δ2 * x

d1 : ℤ → ℤ → ℤ × ℤ → ℤ
d1 δ1 δ2 (a , b) = δ2 * a + - (δ1 * b)

-- d1 ∘ d0 = 0 for every pair.

complex : (δ1 δ2 x : ℤ) → d1 δ1 δ2 (d0 δ1 δ2 x) ≡ pos 0
complex δ1 δ2 x =
  solve 3 (λ D1 D2 X → D2 :* (D1 :* X) :+ :- (D1 :* (D2 :* X)) := con (pos 0))
        refl δ1 δ2 x

------------------------------------------------------------------------
-- (delta1, delta2) = (0, 0): both differentials vanish
------------------------------------------------------------------------
-- H^0 = Z (every x is in ker d0), H^1 = Z^2 (every pair is in ker d1,
-- nothing is in im d0 except 0), H^2 = Z (d1 has zero image).

d0-zero : (x : ℤ) → d0 (pos 0) (pos 0) x ≡ (pos 0 , pos 0)
d0-zero x = refl

d1-zero : (a b : ℤ) → d1 (pos 0) (pos 0) (a , b) ≡ pos 0
d1-zero a b = refl

------------------------------------------------------------------------
-- (delta1, delta2) = (2, 4), gcd 2: H^1 = H^2 = Z/2
------------------------------------------------------------------------

-- H^2 = coker d1: the image of d1 is exactly the even integers.

im-d1-even-24 : (a b : ℤ) →
  d1 (pos 2) (pos 4) (a , b) ≡ pos 2 * (pos 2 * a + - b)
im-d1-even-24 a b =
  solve 2 (λ A B → con (pos 4) :* A :+ :- (con (pos 2) :* B)
                   := con (pos 2) :* (con (pos 2) :* A :+ :- B))
        refl a b

even-in-im-24 : (k : ℤ) → d1 (pos 2) (pos 4) (pos 0 , - k) ≡ pos 2 * k
even-in-im-24 k =
  solve 1 (λ K → con (pos 4) :* con (pos 0) :+ :- (con (pos 2) :* (:- K))
                 := con (pos 2) :* K)
        refl k

-- The class of 1 in H^2 is nonzero (no integer is half of 1), and 2 * 1
-- is zero (it is in the image: `even-in-im-24` at k = 1).

one-not-in-im-24 : (a b : ℤ) → ¬ (d1 (pos 2) (pos 4) (a , b) ≡ pos 1)
one-not-in-im-24 a b h =
  2x≢1 (pos 2 * a + - b) (trans (sym (im-d1-even-24 a b)) h)

-- H^1 = ker d1 / im d0. First, ker d1 = Z * (1, 2).

2z≡0⇒z≡0 : (z : ℤ) → pos 2 * z ≡ pos 0 → z ≡ pos 0
2z≡0⇒z≡0 (pos zero)  _ = refl
2z≡0⇒z≡0 (pos (suc n)) ()
2z≡0⇒z≡0 (neg[1+ n ])  ()

ker-d1-24 : (a b : ℤ) → d1 (pos 2) (pos 4) (a , b) ≡ pos 0 → b ≡ pos 2 * a
ker-d1-24 a b h =
  trans b-eq (trans (cong (λ z → pos 2 * a + - z) z0) (+-identityʳ (pos 2 * a)))
  where
  z0 : pos 2 * a + - b ≡ pos 0
  z0 = 2z≡0⇒z≡0 (pos 2 * a + - b) (trans (sym (im-d1-even-24 a b)) h)
  b-eq : b ≡ pos 2 * a + - (pos 2 * a + - b)
  b-eq = solve 2 (λ A B → B := con (pos 2) :* A :+ :- (con (pos 2) :* A :+ :- B))
               refl a b

in-ker-24 : (a : ℤ) → d1 (pos 2) (pos 4) (a , pos 2 * a) ≡ pos 0
in-ker-24 a =
  solve 1 (λ A → con (pos 4) :* A :+ :- (con (pos 2) :* (con (pos 2) :* A))
                 := con (pos 0))
        refl a

-- Second, the generator g = (1, 2) is not in im d0 = {(2x, 4x)}, but
-- 2 g is (at x = 1). So the class of g has order exactly 2.

g-not-in-im-d0-24 : (x : ℤ) → ¬ (d0 (pos 2) (pos 4) x ≡ (pos 1 , pos 2))
g-not-in-im-d0-24 x h = 2x≢1 x (cong proj₁ h)

twice-g-in-im-d0-24 : d0 (pos 2) (pos 4) (pos 1) ≡ (pos 2 , pos 4)
twice-g-in-im-d0-24 = refl

------------------------------------------------------------------------
-- (delta1, delta2) = (3, 5), coprime: H^1 = H^2 = 0
------------------------------------------------------------------------

-- H^2 = 0: every integer c is in the image of d1, at (2c, 3c)
-- (Bezout: 5 * 2 - 3 * 3 = 1).

im-d1-all-35 : (c : ℤ) → d1 (pos 3) (pos 5) (pos 2 * c , pos 3 * c) ≡ c
im-d1-all-35 c =
  solve 1 (λ C → con (pos 5) :* (con (pos 2) :* C) :+ :- (con (pos 3) :* (con (pos 3) :* C))
                 := C)
        refl c

-- H^1 = 0: every element of ker d1 is already in im d0, at
-- x = 2 b - 3 a.

ker-d1-in-im-d0-35 : (a b : ℤ) → d1 (pos 3) (pos 5) (a , b) ≡ pos 0 →
  Σ ℤ (λ x → (a ≡ pos 3 * x) × (b ≡ pos 5 * x))
ker-d1-in-im-d0-35 a b h = x , a-eq′ , b-eq′
  where
  x : ℤ
  x = pos 2 * b + - (pos 3 * a)
  a-eq : a ≡ pos 3 * x + pos 2 * (pos 5 * a + - (pos 3 * b))
  a-eq = solve 2 (λ A B → A := con (pos 3) :* (con (pos 2) :* B :+ :- (con (pos 3) :* A))
                               :+ con (pos 2) :* (con (pos 5) :* A :+ :- (con (pos 3) :* B)))
               refl a b
  b-eq : b ≡ pos 5 * x + pos 3 * (pos 5 * a + - (pos 3 * b))
  b-eq = solve 2 (λ A B → B := con (pos 5) :* (con (pos 2) :* B :+ :- (con (pos 3) :* A))
                               :+ con (pos 3) :* (con (pos 5) :* A :+ :- (con (pos 3) :* B)))
               refl a b
  a-eq′ : a ≡ pos 3 * x
  a-eq′ = trans a-eq (trans (cong (λ z → pos 3 * x + pos 2 * z) h)
                            (+-identityʳ (pos 3 * x)))
  b-eq′ : b ≡ pos 5 * x
  b-eq′ = trans b-eq (trans (cong (λ z → pos 5 * x + pos 3 * z) h)
                            (+-identityʳ (pos 5 * x)))
