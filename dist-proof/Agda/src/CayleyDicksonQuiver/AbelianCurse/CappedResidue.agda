-- CayleyDicksonQuiver.AbelianCurse.CappedResidue
--
-- Residues that remember whether the number was large.
--
-- Reduction modulo M = n + 1 is a monoid map for + and *, but it forgets
-- how big a number was.  Anything that needs the size as well -- an exponent
-- x in a^x modulo m, where `a^x = a^(x mod p)` holds only once x is past the
-- index of `a` -- cannot be computed from the residue alone.  The size is
-- recovered by the congruence generated by the single rule
--
--     x ~ x + M      (for M <= x),
--
-- whose classes are the numbers below M, each on its own, and the residues
-- modulo M among the numbers from M on: the residue together with one bit,
-- "is x at least M".  This is the standard "x if x < M else x mod M + M"
-- trick, and this file proves what makes it usable:
--
--   * `_≈_` is a congruence for + and *               (+-cong, *-cong);
--   * `cap` is a normal form: x ≈ y  iff  cap x ≡ cap y   (cap-inv, cap-complete);
--   * the residue loses the size and `cap` recovers it, in the form of
--     `Algebra.Separates`                              (residue-loses-size);
--   * the capped numbers are a monoid under multiplication, a target for
--     `AssociatorRelation.Eval`                        (CapMon).
--
-- NOT proved here: that `x ↦ a^x mod m` factors through `_≈_` for a suitable
-- M (a statement about the index and period of a in Z/m).
--
-- (The idea came from asking how the first and the second Knuth arrow differ:
-- the first, exponentiation, is not associative and its value depends on the
-- size of the exponent; the second fixes the bracketing, but evaluating a
-- tower modulo m still needs the sizes of the exponents, not only their
-- residues.)
--
-- Not imported by `Everything`; may contain holes.
module CayleyDicksonQuiver.AbelianCurse.CappedResidue where

open import Algebra.Separates using (Separates)
open import CayleyDicksonQuiver.AssociatorRelation using (Mon)
open import Data.Empty using (⊥-elim)
open import Data.Nat
open import Data.Nat.DivMod using (_%_; _/_; m≡m%n+[m/n]*n; [m+kn]%n≡m%n; m%n<n)
open import Data.Nat.Properties
open import Data.Product using (Σ; _,_; proj₁; _×_)
open import Relation.Binary.PropositionalEquality
open import Relation.Nullary using (yes; no; ¬_)

module Cap (n : ℕ) where

  M : ℕ
  M = suc n

  ----------------------------------------------------------------------
  -- The congruence generated by  x ~ x + M  (M <= x)
  ----------------------------------------------------------------------

  infix 4 _≈_

  data _≈_ : ℕ → ℕ → Set where
    ≈-refl  : ∀ {x} → x ≈ x
    ≈-sym   : ∀ {x y} → x ≈ y → y ≈ x
    ≈-trans : ∀ {x y z} → x ≈ y → y ≈ z → x ≈ z
    ≈-shift : ∀ {x} → M ≤ x → x ≈ x + M

  ≡⇒≈ : ∀ {x y} → x ≡ y → x ≈ y
  ≡⇒≈ refl = ≈-refl

  -- k shifts at once
  shift-many : ∀ k {a} → M ≤ a → a ≈ a + k * M
  shift-many zero    {a} h = ≡⇒≈ (sym (+-identityʳ a))
  shift-many (suc k) {a} h =
    ≈-trans (shift-many k h)
      (subst ((a + k * M) ≈_)
             (trans (+-assoc a (k * M) M) (cong (a +_) (+-comm (k * M) M)))
             (≈-shift (≤-trans h (m≤m+n a (k * M)))))

  ----------------------------------------------------------------------
  -- It is a congruence for + and *
  ----------------------------------------------------------------------

  +-congˡ : ∀ {x y} z → x ≈ y → x + z ≈ y + z
  +-congˡ z ≈-refl          = ≈-refl
  +-congˡ z (≈-sym e)       = ≈-sym (+-congˡ z e)
  +-congˡ z (≈-trans e1 e2) = ≈-trans (+-congˡ z e1) (+-congˡ z e2)
  +-congˡ z (≈-shift {x} h) =
    subst ((x + z) ≈_)
          (trans (+-assoc x z M) (trans (cong (x +_) (+-comm z M)) (sym (+-assoc x M z))))
          (≈-shift (≤-trans h (m≤m+n x z)))

  +-congʳ : ∀ x {y z} → y ≈ z → x + y ≈ x + z
  +-congʳ x {y} {z} e = subst₂ _≈_ (+-comm y x) (+-comm z x) (+-congˡ x e)

  +-cong : ∀ {x x' y y'} → x ≈ x' → y ≈ y' → x + y ≈ x' + y'
  +-cong {x' = x'} ex ey = ≈-trans (+-congˡ _ ex) (+-congʳ x' ey)

  *-congˡ : ∀ {x y} z → x ≈ y → x * z ≈ y * z
  *-congˡ z ≈-refl          = ≈-refl
  *-congˡ z (≈-sym e)       = ≈-sym (*-congˡ z e)
  *-congˡ z (≈-trans e1 e2) = ≈-trans (*-congˡ z e1) (*-congˡ z e2)
  *-congˡ zero    (≈-shift {x} h) = ≡⇒≈ (trans (*-zeroʳ x) (sym (*-zeroʳ (x + M))))
  *-congˡ (suc z) (≈-shift {x} h) =
    subst (x * suc z ≈_)
          (sym (trans (*-distribʳ-+ (suc z) x M) (cong (x * suc z +_) (*-comm M (suc z)))))
          (shift-many (suc z)
             (≤-trans h (subst (x ≤_) (sym (*-suc x z)) (m≤m+n x (x * z)))))

  *-congʳ : ∀ x {y z} → y ≈ z → x * y ≈ x * z
  *-congʳ x {y} {z} e = subst₂ _≈_ (*-comm y x) (*-comm z x) (*-congˡ x e)

  *-cong : ∀ {x x' y y'} → x ≈ x' → y ≈ y' → x * y ≈ x' * y'
  *-cong {x' = x'} ex ey = ≈-trans (*-congˡ _ ex) (*-congʳ x' ey)

  ----------------------------------------------------------------------
  -- The normal form: the residue, with M added once the number is large
  ----------------------------------------------------------------------

  cap : ℕ → ℕ
  cap x with M ≤? x
  ... | yes _ = x % suc n + M
  ... | no  _ = x

  cap-small : ∀ {x} → x < M → cap x ≡ x
  cap-small {x} lt with M ≤? x
  ... | yes h = ⊥-elim (<⇒≱ lt h)
  ... | no  _ = refl

  cap-big : ∀ {x} → M ≤ x → cap x ≡ x % suc n + M
  cap-big {x} h with M ≤? x
  ... | yes _  = refl
  ... | no  ¬h = ⊥-elim (¬h h)

  -- a large number is related to its normal form
  big-sound : ∀ x → M ≤ x → x ≈ x % suc n + M
  big-sound x h = go (x / suc n) (m≡m%n+[m/n]*n x (suc n))
    where
    r : ℕ
    r = x % suc n

    go : ∀ q → x ≡ r + q * suc n → x ≈ r + M
    go zero e =
      ⊥-elim (<⇒≱ (subst (_< M) (sym (trans e (+-identityʳ r))) (m%n<n x (suc n))) h)
    go (suc q) e =
      ≈-sym (subst ((r + M) ≈_) (trans (+-assoc r M (q * M)) (sym e))
                   (shift-many q (m≤n+m M r)))

  cap-sound : ∀ x → x ≈ cap x
  cap-sound x with M ≤? x
  ... | yes h = big-sound x h
  ... | no  _ = ≈-refl

  -- adding M to a large number does not change its residue
  %-shift : ∀ x → (x + M) % suc n ≡ x % suc n
  %-shift x = trans (cong (λ t → t % suc n) (sym (cong (x +_) (*-identityˡ M))))
                    ([m+kn]%n≡m%n x 1 (suc n))

  -- related numbers have the same normal form
  cap-inv : ∀ {x y} → x ≈ y → cap x ≡ cap y
  cap-inv ≈-refl          = refl
  cap-inv (≈-sym e)       = sym (cap-inv e)
  cap-inv (≈-trans e1 e2) = trans (cap-inv e1) (cap-inv e2)
  cap-inv (≈-shift {x} h) =
    trans (cap-big h)
      (trans (cong (_+ M) (sym (%-shift x)))
             (sym (cap-big (≤-trans h (m≤m+n x M)))))

  -- and numbers with the same normal form are related
  cap-complete : ∀ {x y} → cap x ≡ cap y → x ≈ y
  cap-complete {x} {y} e =
    ≈-trans (cap-sound x) (≈-trans (≡⇒≈ e) (≈-sym (cap-sound y)))

  cap-idem : ∀ x → cap (cap x) ≡ cap x
  cap-idem x = cap-inv (≈-sym (cap-sound x))

  -- the normal form is compatible with + and *: capping the operands
  -- first does not change the capped result
  cap-add : ∀ x y → cap (x + y) ≡ cap (cap x + cap y)
  cap-add x y = cap-inv (+-cong (cap-sound x) (cap-sound y))

  cap-mul : ∀ x y → cap (x * y) ≡ cap (cap x * cap y)
  cap-mul x y = cap-inv (*-cong (cap-sound x) (cap-sound y))

  ----------------------------------------------------------------------
  -- The residue loses the size; the normal form recovers it
  ----------------------------------------------------------------------
  -- x and x + M have the same residue, but for x < M they are different
  -- numbers of different sizes: `cap` tells them apart.  This is the shape
  -- of `Algebra.Separates` with T = residue and S = the normal form.

  residue-loses-size : ∀ x → x < M →
    Separates (λ t → t % suc n) cap x (x + M)
  residue-loses-size x lt = sym (%-shift x) , distinct
    where
    -- cap x = x < M, while cap (x + M) = (x + M) % M + M >= M
    distinct : ¬ (cap x ≡ cap (x + M))
    distinct e =
      let eq : x ≡ (x + M) % suc n + M
          eq = trans (sym (cap-small lt)) (trans e (cap-big (m≤n+m M x)))
      in <⇒≱ lt (subst (M ≤_) (sym eq) (m≤n+m M ((x + M) % suc n)))

  -- From M on, the residue is all there is: x and x + M have the same normal
  -- form, so the only information the residue misses is the size bit.
  residue-suffices-above : ∀ x → M ≤ x → cap x ≡ cap (x + M)
  residue-suffices-above x h = cap-inv (≈-shift h)

  ----------------------------------------------------------------------
  -- The capped numbers form a monoid under multiplication
  ----------------------------------------------------------------------
  -- Carrier: the fixed points of `cap`.  `Mon` is the target monoid of
  -- `AssociatorRelation.Eval`.

  Capped : Set
  Capped = Σ ℕ (λ c → cap c ≡ c)

  Capped-≡ : ∀ {a b : Capped} → proj₁ a ≡ proj₁ b → a ≡ b
  Capped-≡ {a , p} {.a , q} refl = cong (a ,_) (≡-irrelevant p q)

  _⊗_ : Capped → Capped → Capped
  (a , _) ⊗ (b , _) = cap (a * b) , cap-idem (a * b)

  one : Capped
  one = cap 1 , cap-idem 1

  -- capping one factor first does not change the capped product
  cap-mulˡ : ∀ x y → cap (cap x * y) ≡ cap (x * y)
  cap-mulˡ x y = cap-inv (*-congˡ y (≈-sym (cap-sound x)))

  cap-mulʳ : ∀ x y → cap (x * cap y) ≡ cap (x * y)
  cap-mulʳ x y = cap-inv (*-congʳ x (≈-sym (cap-sound y)))

  ⊗-assoc : ∀ a b c → (a ⊗ b) ⊗ c ≡ a ⊗ (b ⊗ c)
  ⊗-assoc (a , _) (b , _) (c , _) =
    Capped-≡ (trans (cap-mulˡ (a * b) c)
             (trans (cong cap (*-assoc a b c))
                    (sym (cap-mulʳ a (b * c)))))

  ⊗-idˡ : ∀ a → one ⊗ a ≡ a
  ⊗-idˡ (a , p) =
    Capped-≡ (trans (cap-mulˡ 1 a) (trans (cong cap (*-identityˡ a)) p))

  ⊗-idʳ : ∀ a → a ⊗ one ≡ a
  ⊗-idʳ (a , p) =
    Capped-≡ (trans (cap-mulʳ a 1) (trans (cong cap (*-identityʳ a)) p))

  CapMon : Mon
  CapMon = record
    { M = Capped ; _∙_ = _⊗_ ; ε = one
    ; ∙-assoc = ⊗-assoc ; ∙-idˡ = ⊗-idˡ ; ∙-idʳ = ⊗-idʳ }

------------------------------------------------------------------------
-- A concrete instance: M = 4
------------------------------------------------------------------------
-- 2 and 6 have the same residue modulo 4, but only 6 is at least 4; the
-- normal form separates them.

open Cap using (cap; residue-loses-size)

2-and-6 : Separates (λ t → t % 4) (cap 3) 2 6
2-and-6 = residue-loses-size 3 2 (s≤s (s≤s (s≤s z≤n)))

-- below M the normal form is the number itself; from M on it is the residue
-- plus M
cap-3-values : (cap 3 2 ≡ 2) × (cap 3 6 ≡ 6) × (cap 3 4 ≡ 4)
cap-3-values = refl , refl , refl
